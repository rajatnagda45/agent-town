# Agent Town environment template
# Copy this file to .env.local and fill only the sections you use.
# Never commit real tokens, credentials, private URLs, or personal filesystem paths.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

PORT=3000
HOST=127.0.0.1
AGENT_TOWN_DB_PATH=data/agent-town.sqlite

# Supported values: openclaw, nightshift, auggie
AGENT_PROVIDER=openclaw
AGENT_TOWN_SHARED_AGENT=main
AGENT_TOWN_OFFICE_LEAD_SEAT=seat-0

# Optional custom emergency-stop marker. The default is next to the SQLite DB.
# AGENT_TOWN_ESTOP_FILE=data/ESTOP

# Comma-separated HTTPS origins allowed only when an authenticated TLS proxy is used.
# AGENT_TOWN_PUBLIC_ORIGINS=https://agent-town.example.com

# -----------------------------------------------------------------------------
# OpenClaw provider (default core workflow)
# -----------------------------------------------------------------------------

GATEWAY_URL=ws://127.0.0.1:18789/
GATEWAY_TOKEN=

# Optional protocol discovery overrides. Usually automatic discovery is sufficient.
# OPENCLAW_PACKAGE_DIR=/absolute/path/to/openclaw
# OPENCLAW_PROTOCOL_MODULE=/absolute/path/to/openclaw/dist/gateway/protocol/index.js

# Remote gateways must use wss:// and require this explicit opt-in.
# ALLOW_REMOTE_GATEWAY=true

# -----------------------------------------------------------------------------
# Meterless Nightshift provider
# -----------------------------------------------------------------------------

NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_API_KEY=
NIGHTSHIFT_MODEL=meterless/auto

# -----------------------------------------------------------------------------
# Meterless H-MEM decision memory
# -----------------------------------------------------------------------------

# H-MEM runs inside Agent Town and persists through AGENT_TOWN_DB_PATH. It is a
# local reference implementation, not a hosted API, so there is no HMEM_API_KEY.
# Configure the optional embeddings section below only if semantic ranking is
# required; H-MEM continues to work with lexical ranking when it is omitted.

# -----------------------------------------------------------------------------
# NVIDIA / Nemotron (adapter-ready)
# -----------------------------------------------------------------------------

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# NGC_API_KEY is separate: it is used to pull/download a self-hosted NIM image
# and model artifacts. It is not the hosted inference credential above.
# NGC_API_KEY=

# -----------------------------------------------------------------------------
# SpaceXAI / Grok (active Agent Town provider yet)
# -----------------------------------------------------------------------------

# SpaceXAI's API uses XAI_API_KEY and an OpenAI-compatible endpoint.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6

# -----------------------------------------------------------------------------
# Reviewed specialist configuration
# -----------------------------------------------------------------------------

# JSON array of {"manifestId","seatId","sessionKey"?} bindings.
AGENT_TOWN_SPECIALIST_GRANTS=[]

# JSON object keyed by reviewed manifest ID. Used only for supported OpenClaw
# provisioning profiles: {"manifest-id":{"seatId","name","workspace","label"?}}.
AGENT_TOWN_SPECIALIST_PROFILES={}

# Optional secondary OpenClaw runtimes. Tokens are referenced by environment
# variable name; never place a literal token inside this JSON.
AGENT_TOWN_EXECUTION_OPTIONS=[]
AGENT_TOWN_EXECUTION_PREFERENCE=[]

# -----------------------------------------------------------------------------
# Inventory evidence mode
# -----------------------------------------------------------------------------

# Leave unset for no inventory reader. Supported values: synthetic, zetaris.
# AGENT_TOWN_INVENTORY_MODE=synthetic

# Safe local demonstration fixtures:
# AGENT_TOWN_INVENTORY_SYNTHETIC_CASE=complete
# AGENT_TOWN_INVENTORY_SYNTHETIC_PROFILE=sku17-bin-a

# -----------------------------------------------------------------------------
# Zetaris evidence source
# -----------------------------------------------------------------------------

# Enable only after all endpoints and credentials match the installed contract.
# For local HTTP, all endpoints must be loopback and ALLOW_LOOPBACK_HTTP must be 1.
ZETARIS_OPEN_URL=http://127.0.0.1:8888/api/v1.0/query/sql/start
ZETARIS_PAGE_URL=http://127.0.0.1:8888/api/v1.0/query/sql/page
ZETARIS_CLOSE_URL=http://127.0.0.1:8888/api/v1.0/query/sql/close/{queryToken}
ZETARIS_PAGE_METHOD=GET
ZETARIS_CLOSE_METHOD=DELETE
ZETARIS_BEARER_TOKEN=
ZETARIS_ORG_ID=
ZETARIS_ROWS_KEY=records
ZETARIS_QUERY_TOKEN_KEY=queryToken
ZETARIS_PROBE_SELECT=SELECT 1 AS readiness_check
ZETARIS_ALLOW_LOOPBACK_HTTP=1

# Bounded timeout tuning in milliseconds.
ZETARIS_OPEN_TIMEOUT_MS=10000
ZETARIS_OPEN_MAX_TIMEOUT_MS=120000
ZETARIS_PAGE_TIMEOUT_MS=10000
ZETARIS_CLEANUP_TIMEOUT_MS=10000
ZETARIS_QUERY_TIMINGS_PATH=data/zetaris-query-timings.json

# -----------------------------------------------------------------------------
# Web evidence (Tavily)
# -----------------------------------------------------------------------------

TAVILY_API_KEY=
# Alternatively, use Tavily's supported rate-limited keyless mode.
# TAVILY_KEYLESS=1

# -----------------------------------------------------------------------------
# Optional Gemini Live voice
# -----------------------------------------------------------------------------

GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Optional OpenAI-compatible embeddings for memory ranking
# -----------------------------------------------------------------------------

# Recall remains lexical when these settings are omitted.
# AGENT_TOWN_EMBEDDINGS_URL=http://127.0.0.1:11434/v1
# AGENT_TOWN_EMBEDDINGS_MODEL=your-embedding-model
# AGENT_TOWN_EMBEDDINGS_KEY_ENV=EMBEDDINGS_API_KEY
# EMBEDDINGS_API_KEY=
